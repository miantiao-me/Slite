# Core

# Optional. Without it the process generates a random token that is never
# logged or persisted, so public redirects keep working while dashboard and API
# stay inaccessible until a token is configured and the process restarts.
NUXT_SITE_TOKEN=
NUXT_DATA_DIR=./data
# Enable only behind a trusted proxy that overwrites incoming forwarding headers.
NUXT_TRUST_PROXY=false
# Optional GeoIP override. Without it, /data/geoip.mmdb wins over the DB-IP City
# Lite database bundled in the image. Geographic lookups fail open when no
# database exists, and City Lite does not include time-zone data.
NUXT_GEOIP_PATH=

# Optional AI

# AI stays disabled until both NUXT_AI_BASE_URL and NUXT_AI_MODEL are set; the API key is optional for local providers.
NUXT_AI_API_KEY=
NUXT_AI_BASE_URL=
NUXT_AI_MODEL=
# Optional prompt overrides for the slug and OpenGraph assistants; empty keeps the built-in prompts.
NUXT_AI_PROMPT=
NUXT_AI_OG_PROMPT=

# Public overrides

# Read-only preview deployment: link edits and deletes are rejected, and new
# links expire after the short preview TTL.
NUXT_PUBLIC_PREVIEW_MODE=false
NUXT_PUBLIC_SLUG_DEFAULT_LENGTH=6
NUXT_PUBLIC_IMPORT_BATCH_LIMIT=50

# Optional runtime configuration

NUXT_HOME_URL=
NUXT_NOT_FOUND_REDIRECT=
# Optional DNS-over-HTTPS JSON endpoint for unsafe-link detection; empty disables the check.
NUXT_SAFE_BROWSING_DOH=
NUXT_WEBHOOK_URL=
NUXT_WEBHOOK_SECRET=

# Advanced defaults

NUXT_REDIRECT_STATUS_CODE=301
NUXT_REDIRECT_WITH_QUERY=false
NUXT_REDIRECT_NO_STORE=false
NUXT_CASE_SENSITIVE=false
NUXT_IMPORT_REQUEST_LIMIT=100
NUXT_LIST_QUERY_LIMIT=500
NUXT_DISABLE_BOT_ACCESS_LOG=false
NUXT_DISABLE_AUTO_BACKUP=false

# Build-time

# Source builds and `nuxt dev` only: exactly `true` enables CORS on /api/**.
# The flag is baked into the server build and has no effect on the released
# Docker image.
NUXT_API_CORS=false
