{
  "name": "slite",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev --port 5483",
    "dev:docs": "pnpm --filter @slite/docs dev",
    "build:docs": "pnpm --filter @slite/docs build",
    "preview:docs": "pnpm --filter @slite/docs preview",
    "analyze": "nuxt analyze",
    "test": "vitest",
    "prebuild": "pnpm build:sphere",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 nuxt build",
    "build:map": "node scripts/build-map.js",
    "build:sphere": "node scripts/build-sphere.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "locales:check": "node scripts/check-locales.js",
    "types:check": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "geoip": "GEOIP_DIR=./data node scripts/download-dbip.mjs",
    "preview": "node .output/server/index.mjs",
    "postinstall": "pnpm build:map && nuxt prepare",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.24.0",
    "@number-flow/vue": "^0.5.1",
    "@nuxt/eslint": "^1.16.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.4.1",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/vue-form": "^1.33.1",
    "@tanstack/vue-table": "^8.21.3",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.1.1",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vueuse/core": "^14.3.0",
    "@xsai/generate-text": "^0.5.0",
    "@xsai/shared": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "destr": "^2.0.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "embla-carousel-vue": "^8.6.0",
    "es-toolkit": "^1.49.0",
    "eslint": "^10.7.0",
    "eslint-plugin-better-tailwindcss": "^4.6.1",
    "eslint-plugin-format": "^2.0.1",
    "h3": "^1.15.11",
    "intl-parse-accept-language": "^1.0.0",
    "kysely": "0.29.3",
    "lint-staged": "^17.0.8",
    "lru-cache": "^11.5.2",
    "maxmind": "^5.0.7",
    "nanoid": "^5.1.16",
    "nitropack": "^2.13.4",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "qr-code-styling": "^1.9.2",
    "reka-ui": "^2.10.1",
    "shadcn-nuxt": "^2.7.4",
    "shadcn-vue": "^2.7.4",
    "simple-git-hooks": "^2.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "twgl.js": "^7.0.0",
    "typescript": "^5.9.3",
    "ua-parser-js": "^2.0.10",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "virtua": "^0.49.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-input-otp": "^0.3.2",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.7",
    "vue3-simple-icons": "^16.10.0",
    "zod": "^4.4.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix"
    ]
  }
}
